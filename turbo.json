{
    "$schema": "./node_modules/turbo/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build",
                "^db:generate"
            ],
            "outputs": [
                "dist/**",
                "build/**"
            ]
        },
        "typecheck": {
            "cache": false,
            "dependsOn": [
                "^typecheck",
                "^db:generate",
                "^build",
            ]
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ],
            "cache": false
        },
        "test": {
            "dependsOn": [
                "^test"
            ],
            "cache": false
        },
        "dev": {
            "dependsOn": [
                "^db:generate"
            ],
            "cache": false,
            "persistent": true
        },
        "db:generate": {
            "cache": false
        }
    }
}