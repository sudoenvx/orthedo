{
  "extends": "@orthedo/tsconfig/react-library.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "resolvePackageJsonImports": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@orthedo/ui/src/*": ["./src/*"],
      "@orthedo/theme": ["../theme/src/index.ts"],
      "@orthedo/utils": ["../utils/src/index.ts"]
    }
  },
  "references": [
    { "path": "../theme" },
    { "path": "../utils" }
  ],
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist"
  ]
}
