{
  "extends": "@orthedo/tsconfig/base.json",
  "compilerOptions": {
    "target": "ESNext",
    "ignoreDeprecations": "6.0",
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "prisma/**/*",
    "./prisma.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/generated"
  ]
}