{
  "extends": "@orthedo/tsconfig/node.json",
  "compilerOptions": {
    "target": "es2025",
    "module": "esnext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "prisma/**/*",
    "./prisma.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}