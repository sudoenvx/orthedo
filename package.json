{
  "name": "orthedo",
  "version": "1.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "build:admin": "turbo run build --filter=@orthedo/admin-cpanel",
    "build:lab": "turbo run build --filter=@orthedo/lab-cpanel",
    "build:db": "turbo run build --filter=@orthedo/database",
    "build:api": "turbo run build --filter=@orthedo/api",
    "dev:admin": "turbo run dev --filter=@orthedo/admin-cpanel"
  },
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.13.4",
    "turbo": "^2.10.12",
    "typescript": "^6.0.2"
  }
}
